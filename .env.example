# Copy to .env (gitignored) and fill in. Only the Jev key is needed; everything
# else (Scryfall, EDHREC, Commander Spellbook) is keyless.
TYPESAFE_API_KEY=

# Optional overrides
# EDH_JEV_MODEL=jev-latest        # pin e.g. jev-1.13.0 if you tune thresholds
# EDH_JEV_WORKERS=4               # concurrent Jev requests
# EDH_FORGE_SLOTS=3               # concurrent Forge JVMs (default: CPUs - 1)
# EDH_FORGE_XMX=1536m             # heap per Forge JVM
# FORGE_SRC=/path/to/forge        # use an existing Forge checkout instead of data/forge/src
